# Frontend (Vite + Clerk)
# Coloque sua Publishable Key do Clerk (pk_test_... ou pk_live_...)
# Quando vazia, o sistema ativa automaticamente o modal de login local compatível com Clerk para testes.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Backend / Vercel Serverless Functions (/api)
PORT=8080
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8080

# Clerk Secret Key (para sincronizar status da assinatura e aviso de 3 dias no public_metadata do usuário)
CLERK_SECRET_KEY=

# Mercado Pago Access Token (para gerar assinaturas recorrentes reais na API /preapproval do Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN=

# Armazenamento gratuito na própria Vercel (aba Storage do projeto na Vercel - opcional, ativado automaticamente se preenchido):
# 1. Vercel KV / Upstash Redis (Banco de dados para assinaturas e parceiros)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 2. Vercel Blob (Bucket de imagens na Vercel - igual ao MinIO/S3, com 1 GB gratuito)
BLOB_READ_WRITE_TOKEN=
